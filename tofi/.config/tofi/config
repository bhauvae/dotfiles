# ~/.config/tofi/config

font = "monospace"
font-size = 14

prompt-text = "run: "
placeholder-text = ""

width = 100%
height = 100%
padding-left = 40%
padding-top = 40%

border-width = 0
outline-width = 0

num-results = 6
result-spacing = 10
matching-algorithm = fuzzy

text-color = #cdd6f4
prompt-color = #f38ba8
selection-color = #f9e2af
background-color = #1e1e2ecc

hide-cursor = true
text-cursor = false
history = true
require-match = true
auto-accept-single = true
physical-keybindings = true
drun-launch = true
multi-instance = false
ascii-input = false
